---
import Layout from '../layouts/Layout.astro';
import getPosts from '../lib/getPosts';
import QuoteCard from '../components/QuoteCard.astro';
import { SITE_NAME } from '../lib/seo';

const COUNT = 10;

const posts = await getPosts();
const latest = posts
  .filter(post => post.added)
  .sort((a, b) => new Date(b.added) - new Date(a.added))
  .slice(0, COUNT);

const formatDate = iso =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const description = `The ${COUNT} quotes most recently added to ${SITE_NAME}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Latest quotes | ${SITE_NAME}`,
  description,
  ...(Astro.site && { url: new URL(Astro.url.pathname, Astro.site).href }),
  hasPart: latest.map(post => ({
    '@type': 'Quotation',
    text: post.fields.quote,
    dateCreated: post.added,
    ...(post.fields.author && { creator: { '@type': 'Person', name: post.fields.author } }),
    ...(Astro.site && { url: new URL(`/quote/${post.slug}/`, Astro.site).href }),
  })),
};
---

<Layout title={`Latest quotes | ${SITE_NAME}`} description={description} jsonLd={jsonLd}>
  <header class="h-42">
    <div class="w-full">
      <h1 class="block text-6xl md:text-8xl font-display mb-4">Latest</h1>
      <p class="text-xl text-gray-500 mb-8">The {COUNT} most recent additions to the book.</p>
    </div>
  </header>

  <ol aria-label="Latest quotes" class="text-xl grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {latest.map(post => (
      <li class="flex flex-col gap-2">
        <time datetime={post.added} class="text-sm font-semibold uppercase tracking-widest text-gray-400">
          Added {formatDate(post.added)}
        </time>
        <QuoteCard post={post} class="flex-1" />
      </li>
    ))}
  </ol>
</Layout>
