---
import Layout from '../../layouts/Layout.astro';
import getPosts from '../../lib/getPosts';
import QuoteCard from '../../components/QuoteCard.astro';
import { SITE_NAME, truncate } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getPosts();
  const authors = new Map();
  posts.forEach(post => {
    if (!post.authorSlug) return;
    if (!authors.has(post.authorSlug)) {
      authors.set(post.authorSlug, {
        name: post.fields.author,
        bio: post.authorBio || null,
        quotes: [],
      });
    } else if (!authors.get(post.authorSlug).bio && post.authorBio) {
      authors.get(post.authorSlug).bio = post.authorBio;
    }
    authors.get(post.authorSlug).quotes.push(post);
  });
  return [...authors].map(([slug, author]) => ({
    params: { author: slug },
    props: author,
  }));
}

const { name, bio, quotes } = Astro.props;
const searchUrl = `https://www.google.com/search?q=${encodeURIComponent(name)}`;

const count = quotes.length === 1 ? '1 quote' : `${quotes.length} quotes`;
const description = truncate(
  bio ? `${count} by ${name}. ${bio}` : `${count} by ${name}, including “${quotes[0]?.fields?.quote ?? ''}”`
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Quotes by ${name}`,
  about: {
    '@type': 'Person',
    name,
    ...(bio && { description: bio }),
  },
  hasPart: quotes.map(post => ({
    '@type': 'Quotation',
    text: post.fields.quote,
    creator: { '@type': 'Person', name },
    ...(Astro.site && { url: new URL(`/quote/${post.slug}/`, Astro.site).href }),
  })),
};
---

<Layout title={`Quotes by ${name} | ${SITE_NAME}`} description={description} jsonLd={jsonLd}>
  <header class="mb-12">
    <div class="w-full">
      <h1 class:list={['block text-6xl md:text-8xl font-display', bio ? 'mb-4' : 'mb-8']}>{name}</h1>
      {bio && (
        <p class="text-xl text-gray-600 max-w-3xl leading-relaxed">
          {bio}
        </p>
      )}
    </div>
  </header>
  <section aria-label="Quotes" class="text-xl grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {quotes.map(post => <QuoteCard post={post} />)}
  </section>

  <p class="mt-12 text-lg flex flex-wrap gap-x-6 gap-y-2">
    <a href={searchUrl} target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:underline">
      Find out more about {name} &rarr;<span class="sr-only"> (Google search, opens in a new tab)</span>
    </a>
    <a href="/quotes/" class="text-gray-500 hover:text-blue-500 hover:underline">
      &larr; Browse all quotes
    </a>
  </p>
</Layout>
