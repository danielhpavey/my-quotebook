---
import Layout from '../layouts/Layout.astro';
import getPosts from '../lib/getPosts';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/seo';
import { quoteOfTheDay } from '../lib/quoteOfTheDay';
import QuoteCard from '../components/QuoteCard.astro';

const LATEST_COUNT = 20;

const posts = await getPosts();
const latestPosts = [...posts]
  .filter(post => post.added)
  .sort((a, b) => new Date(b.added) - new Date(a.added))
  .slice(0, LATEST_COUNT);

// chosen when the site is built; the scheduled rebuilds pick up the new day's quote
const today = new Date();
const featured = quoteOfTheDay(posts, today);
const todayLabel = today.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  ...(Astro.site && { url: Astro.site.href }),
};
---

<Layout title={`${SITE_NAME} – favourite quotes`} jsonLd={jsonLd}>
  <header class="h-42">
    <div class="w-full">
      <h1 class="block text-6xl md:text-8xl font-display mb-8">Quotebook</h1>
    </div>
  </header>

  {featured && (
    <section aria-labelledby="qotd-heading" class="mb-12 rounded-2xl bg-blue-500 text-white shadow-lg p-8 md:p-12">
      <h2 id="qotd-heading" class="flex flex-wrap items-baseline gap-x-3 text-sm font-semibold uppercase tracking-widest text-blue-100">
        Quote of the day
        <time datetime={today.toISOString().slice(0, 10)} class="font-normal normal-case tracking-normal">{todayLabel}</time>
      </h2>
      <figure class="mt-6">
        <blockquote class="text-3xl md:text-5xl leading-tight font-medium">&ldquo;{featured.fields.quote}&rdquo;</blockquote>
        {featured.fields.author && (
          <figcaption class="mt-6 text-xl md:text-2xl text-blue-50">
            &mdash; {featured.authorSlug
              ? <a href={`/author/${featured.authorSlug}/`} class="underline decoration-blue-300 underline-offset-4 hover:decoration-white">{featured.fields.author}</a>
              : featured.fields.author}
          </figcaption>
        )}
      </figure>
      <a href={`/quote/${featured.slug}/`} class="mt-8 inline-block rounded-full bg-white px-5 py-2 font-semibold text-blue-600 hover:bg-blue-50 transition">
        View &amp; share &rarr;
      </a>
    </section>
  )}

  <form role="search" action="/quotes/" method="get" class="mb-12 max-w-xl">
    <label for="search" class="sr-only">Search quotes and authors</label>
    <div class="relative">
      <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.45 4.39l3.08 3.08a.75.75 0 1 1-1.06 1.06l-3.08-3.08A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
      </svg>
      <input
        id="search"
        type="search"
        name="q"
        placeholder="Search quotes or authors…"
        autocomplete="off"
        class="w-full rounded-full border border-gray-300 bg-white py-3 pl-12 pr-4 text-lg shadow-sm placeholder:text-gray-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
      />
    </div>
  </form>

  <section aria-labelledby="latest-heading" class="mb-12">
    <div class="flex items-baseline justify-between mb-6">
      <h2 id="latest-heading" class="text-2xl md:text-3xl font-display font-semibold text-gray-800">Latest quotes</h2>
      <a href="/quotes/" class="text-base font-medium text-blue-500 hover:underline">View all quotes &rarr;</a>
    </div>
    <div class="text-xl grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latestPosts.map(post => (
        <QuoteCard post={post} />
      ))}
    </div>
  </section>

  <div class="mt-8 mb-12 text-center">
    <a
      href="/quotes/"
      class="inline-block rounded-full bg-blue-500 px-8 py-3.5 text-lg font-medium text-white hover:bg-blue-600 transition duration-300 shadow-sm hover:shadow"
    >
      View all quotes &rarr;
    </a>
  </div>
</Layout>
