---
import Layout from '../layouts/Layout.astro';
import getPosts from '../lib/getPosts';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/seo';

const posts = await getPosts();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  ...(Astro.site && { url: Astro.site.href }),
};
---

<Layout title={`${SITE_NAME} – favourite quotes`} jsonLd={jsonLd}>
  <header class="h-42">
    <div class="w-full">
      <h1 class="block text-6xl md:text-8xl font-display mb-8">Quotebook</h1>
    </div>
  </header>
  <section aria-label="Quotes" class="text-xl grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map(post => (
      <a href={`/quote/${post.slug}`} class="block bg-white border border-gray-200 shadow-sm hover:shadow-lg hover:bg-blue-500 hover:border-blue-500 transition hover:text-white p-6 duration-500 rounded-lg">
        <figure class="quote flex flex-col h-full">
          <blockquote class="flex-1">&ldquo;{post.fields.quote}&rdquo;</blockquote>
          <figcaption class="mt-4 text-base text-right">
            &mdash; {post.fields.author} <cite></cite>
          </figcaption>
        </figure>
      </a>
    ))}
  </section>
</Layout>
